# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=changeme
EVOLUTION_INSTANCE=Fausto
# Ajuste se a versão da Evolution API do cliente usar outro path
EVOLUTION_CONTACTS_PATH=/chat/findContacts

# Twenty (webhook já existente que cria Person)
TWENTY_WEBHOOK_URL=http://host.docker.internal:4000/webhook

# Opcionais
INCLUDE_GROUPS=false
LIMIT=
DELAY_MS=300
DRY_RUN=false
OUTPUT_LOG=./import-results.json
